.DS_Store
.history
/tmp/
/workspace/

# Go build artefacts
/octo
/octo.exe
/octo-desktop
/octo-desktop.exe
cmd/octo-desktop/octo-desktop
# Windows resource objects generated by the build-windows-icon step during CI.
cmd/octo-desktop/*.syso
cmd/octo-desktop/octo-desktop.exe
/cmd/octo/octo
/cmd/octo/octo.exe
/Octo.app
/Octo.AppDir/
/Octo-x86_64.AppImage
/appimagetool.AppImage
/octo-eval
/dist/
*.test
coverage.out
coverage.html

# IDE
/.idea/
/.vscode/

# Local agent / config
/.claude/
.codegraph/
/.worktrees/
/.octo/

# Python bytecode from bundled skill scripts (run via uv/python)
__pycache__/
*.pyc

# Vite build output. go:embed requires the directory to exist with at least
# one file, so only .gitkeep is committed — the real assets are built from
# source (`make web-build` locally, CI for releases), never committed.
/internal/server/webdist/*
!/internal/server/webdist/.gitkeep
.octo/implement-state.json

# Local toolchain (Inno Setup) and packaging scratch
/.tools/
/.audit/_tmp/

# Recycle bin for build products. Nothing is deleted outright: clean-webdist.mjs
# moves the previous webdist output here, one timestamped directory per run,
# each with a manifest.txt. Only the three newest runs are kept; older ones go
# to .trash/_expired/.
/.trash/

# Build transcripts and stray logs (a stage script used to leave one behind).
*.log

# Local audit trail, AI working reports and build transcripts: kept on disk for
# reference, never part of the product or the repository.
/.audit/
/reports/
/build-desktop.log
/cleanup-*.log
/serve-check.*

# Source clone of the startup-screen project used as reference. The runtime
# copy the build actually ships is web/public/dsh-startup.
/dsh-startup-screen/

# Runtime data if the binary is launched from the repository root.
/Data/
/Data-*/


